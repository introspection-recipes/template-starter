# Generated Pi runtime state
.pi/bin/
.pi/mcp-session.json
.pi/mcporter.json
.introspection/local.json

# `.pi/mcp.local.json` is deliberately not ignored: it holds evaluation
# bindings of loopback URLs only, which `introspection check` enforces. Keep a
# personal binding outside the repository and point PI_RECIPES_MCP_LOCAL_CONFIG
# at it (see README, "Add an MCP server").

# Dependencies
node_modules/

# Secrets. `introspection dev` stages with `git add -A`, so anything untracked
# and un-ignored here travels to the cloud inside the development patch.
.env
.env.*
