{
  "name": "@introspection-recipes/template-starter",
  "version": "0.1.1",
  "description": "A Pi coding agent built with Introspection.",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "managed-agent",
    "recipe"
  ],
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "peerDependencies": {
    "@introspection-ai/recipes": "*"
  },
  "pi": {
    "agents": [
      "./agents/*.yaml"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "devDependencies": {
    "@introspection-ai/vitest-evals": ">=0.13.0",
    "vitest": "^4.1.12",
    "vitest-evals": "^0.17.0"
  }
}
